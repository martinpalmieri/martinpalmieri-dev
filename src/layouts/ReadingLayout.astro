---
import BaseLayout from "./BaseLayout.astro";
import Frame from "../components/Frame.astro";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<BaseLayout lang="es" title={title} description={description} bodyClass="bg-cobalt">
  <meta slot="head" name="theme-color" content="#03298F" />

  <Frame locale="es">
    <a slot="top" class="back" href="/es">
      <svg viewBox="0 0 26 12" aria-hidden="true">
        <path d="M25 6H2M7 1 2 6l5 5" fill="none" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
      <span><span class="sr-only">Volver a </span>martinpalmieri.dev</span>
    </a>

    <div class="sheet">
      <div class="book">
        <slot />
      </div>
    </div>
  </Frame>
</BaseLayout>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.75em;
    position: relative;
    color: inherit;
    text-decoration: none;
  }

  .back::before {
    content: "";
    position: absolute;
    top: 50%;
    right: -0.75rem;
    left: -0.75rem;
    height: max(100%, 2.75rem);
    transform: translateY(-50%);
  }

  .back svg {
    width: 1.6em;
    height: auto;
    flex: none;
  }

  .sheet {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 0 clamp(20px, 5vw, 76px) 86px;
    color: #1e211e;
    -webkit-font-smoothing: antialiased;
  }

  .book {
    width: 100%;
    max-width: 710px;
    margin: 0 auto;
  }

  .back:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 0.35rem;
    border-radius: 3px;
  }

  @media (hover: hover) {
    .back:hover > span {
      text-decoration: underline;
      text-underline-offset: 0.3em;
    }
  }

  @media (max-width: 650px) {
    .sheet {
      padding: 0 22px 55px;
    }
  }
</style>
