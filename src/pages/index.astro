---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeDialog from "../components/home/HomeDialog.astro";
import NavTile from "../components/home/NavTile.astro";
import Wordmark from "../components/home/Wordmark.astro";
import contact from "../data/contact.json";
import antonUrl from "../assets/fonts/anton-latin.woff2?url";
import cvIcon from "../assets/home/icon-cv.png";
import musicIcon from "../assets/home/icon-music.png";
import artIcon from "../assets/home/icon-art.png";
import contactIcon from "../assets/home/icon-contact.png";

export const prerender = true;
---

<BaseLayout bodyClass="bg-cobalt">
  <Fragment slot="head">
    <link rel="preload" href={antonUrl} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#03298F" />
  </Fragment>

  <div class="frame">
    <header class="site-id">martinpalmieri.dev</header>
    <main class="paper">
      <h1 class="wordmark">
        <span class="sr-only">Martín Palmieri</span>
        <Wordmark />
      </h1>
      <nav aria-label="Main">
        <ul class="tiles">
          <li><NavTile label="CV" image={cvIcon} href="/cv" /></li>
          <li><NavTile label="Music" image={musicIcon} dialog="music-dialog" /></li>
          <li><NavTile label="Art" image={artIcon} dialog="art-dialog" /></li>
          <li><NavTile label="Contact" image={contactIcon} dialog="contact-dialog" /></li>
        </ul>
      </nav>
    </main>
  </div>

  <HomeDialog id="music-dialog" title="Music" describedby="music-dialog-status">
    <p id="music-dialog-status" class="stamp">Coming soon</p>
  </HomeDialog>
  <HomeDialog id="art-dialog" title="Art" describedby="art-dialog-status">
    <p id="art-dialog-status" class="stamp">Coming soon</p>
  </HomeDialog>
  <HomeDialog id="contact-dialog" title="Contact">
    <ul class="actions">
      <li><a class="action" href={`mailto:${contact.email}`}>Email me</a></li>
      <li>
        <a class="action" href={contact.linkedin} target="_blank" rel="noopener noreferrer">
          LinkedIn<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </li>
      <li>
        <a class="action" href={contact.github} target="_blank" rel="noopener noreferrer">
          GitHub<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </li>
    </ul>
  </HomeDialog>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-dialog-target]").forEach(trigger => {
    const dialog = document.getElementById(trigger.dataset.dialogTarget ?? "");

    if (!(dialog instanceof HTMLDialogElement)) {
      return;
    }

    trigger.addEventListener("click", () => dialog.showModal());
    // Safari doesn't focus buttons on click, so the native focus restore has nothing to return to.
    dialog.addEventListener("close", () => trigger.focus({ preventScroll: true }));
    // Clicks on the backdrop are dispatched to the dialog element itself.
    dialog.addEventListener("click", event => {
      if (event.target === dialog) {
        dialog.close();
      }
    });
  });
</script>

<style>
  .frame {
    --frame-x: clamp(10px, 2.6vw, 44px);
    --frame-top: clamp(34px, 4.6vw, 76px);
    --frame-bottom: clamp(10px, 3vw, 48px);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
    padding: 0 var(--frame-x) var(--frame-bottom);
    background-color: theme("colors.cobalt");
    background-image: var(--grain-cobalt);
  }

  .site-id {
    display: flex;
    align-items: center;
    min-height: var(--frame-top);
    padding-inline: 0.75em;
    color: theme("colors.paper");
    font-size: clamp(0.8125rem, 1.4vw, 1.375rem);
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .paper {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 4svh, 3.5rem);
    padding: clamp(0.75rem, 3svh, 3rem) clamp(1rem, 3.3vw, 3rem);
    background-color: theme("colors.paper");
    background-image: var(--grain-paper);
  }

  .wordmark,
  nav {
    width: 100%;
  }

  .tiles {
    --cols: 2;
    --tile: min(40vw, 18svh, 220px);
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, var(--tile)));
    justify-content: center;
    gap: clamp(1rem, 3svh, 2rem) clamp(1rem, 6vw, 2.5rem);
  }

  .tiles > li:nth-child(even) {
    --tilt: 2deg;
  }

  .stamp {
    display: inline-block;
    margin: 0.25rem 0 0.5rem;
    padding: 0.3em 0.6em 0.25em;
    border: 3px solid currentColor;
    color: theme("colors.riso.red");
    font-family: theme("fontFamily.display");
    font-size: 1.75rem;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transform: rotate(-4deg);
  }

  .actions {
    display: grid;
    gap: 0.875rem;
  }

  .action {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    padding: 0.6rem 1rem 0.5rem;
    border: 3px solid theme("colors.ink");
    background: theme("colors.riso.yellow");
    box-shadow: 4px 4px 0 theme("colors.ink");
    color: theme("colors.ink");
    font-family: theme("fontFamily.display");
    font-size: 1.75rem;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  .actions > li:nth-child(2) .action {
    background: theme("colors.riso.red");
  }

  .actions > li:nth-child(3) .action {
    background: theme("colors.riso.purple");
    color: theme("colors.paper");
  }

  .action:focus-visible {
    outline: 3px solid theme("colors.cobalt");
    outline-offset: 4px;
  }

  @media (hover: hover) {
    .action:hover {
      box-shadow: 6px 6px 0 theme("colors.ink");
      transform: translate(-2px, -2px);
    }
  }

  .action:active {
    box-shadow: 1px 1px 0 theme("colors.ink");
    transform: translate(3px, 3px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .action {
      transition:
        transform 120ms ease-out,
        box-shadow 120ms ease-out;
    }
  }

  :global(html:has(dialog[open])) {
    overflow: hidden;
  }

  @media (min-width: 600px) {
    .tiles {
      --tile: min(34vw, 24svh, 320px);
    }
  }

  @media (min-width: 1024px), (min-width: 600px) and (min-aspect-ratio: 3/2) {
    .tiles {
      --cols: 4;
      --tile: min(20vw, 31svh, 380px);
      column-gap: clamp(1.5rem, 3.5vw, 4rem);
    }
  }
</style>
