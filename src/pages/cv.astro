---
import BaseLayout from "../layouts/BaseLayout.astro";
import Frame from "../components/Frame.astro";
import Footer from "../components/Footer.astro";
import Experience from "../components/cv/Experience.astro";
import { companies } from "../data/cv";

export const prerender = true;

const total = String(companies.length).padStart(2, "0");
---

<BaseLayout
  title="Curriculum Vitae | Martín Palmieri"
  description="Professional experience and background of Martín Palmieri."
  bodyClass="bg-cobalt overflow-hidden"
>
  <meta slot="head" name="theme-color" content="#03298F" />

  <Frame fixed>
    <a slot="top" class="back" href="/">
      <svg viewBox="0 0 26 12" aria-hidden="true">
        <path d="M25 6H2M7 1 2 6l5 5" fill="none" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
      <span><span class="sr-only">Back to </span>martinpalmieri.dev</span>
    </a>

    <p class="progress" aria-hidden="true"><span data-cv-current>01</span> / {total}</p>

    <main class="track" tabindex="0" aria-label="Work experience" data-cv-track>
      <h1 class="sr-only">Martín Palmieri: work experience</h1>
      {companies.map((company, index) => <Experience {...company} eager={index === 0} />)}
    </main>

    <nav class="steps" aria-label="Experience navigation">
      <button type="button" class="step" data-cv-step="-1" aria-label="Previous experience" aria-disabled="true">
        <svg viewBox="0 0 24 30" aria-hidden="true">
          <path d="M12 27V5M3.5 13.5 12 5l8.5 8.5" fill="none" stroke="currentColor" stroke-width="5"></path>
        </svg>
      </button>
      <button type="button" class="step" data-cv-step="1" aria-label="Next experience" aria-disabled="false">
        <svg viewBox="0 0 24 30" aria-hidden="true">
          <path d="M12 3v22M3.5 16.5 12 25l8.5-8.5" fill="none" stroke="currentColor" stroke-width="5"></path>
        </svg>
      </button>
    </nav>

    <p class="sr-only" aria-live="polite" data-cv-status></p>

    <Footer slot="bottom" />
  </Frame>
</BaseLayout>

<script>
  const track = document.querySelector<HTMLElement>("[data-cv-track]");
  const experiences = Array.from(document.querySelectorAll<HTMLElement>("[data-cv-experience]"));
  const counter = document.querySelector("[data-cv-current]");
  const status = document.querySelector("[data-cv-status]");
  const steps = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-cv-step]"));
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const keys: Record<string, number> = { ArrowDown: 1, PageDown: 1, ArrowUp: -1, PageUp: -1 };

  if (track && experiences.length > 0) {
    const last = experiences.length - 1;
    let active = 0;
    // Destination of an in-flight scroll, so repeated presses keep advancing instead of retargeting.
    let pending: number | null = null;
    let pendingTimer = 0;
    let frame = 0;

    const behavior = (): ScrollBehavior => (reducedMotion.matches ? "auto" : "smooth");

    const render = (index: number) => {
      active = index;

      if (counter) {
        counter.textContent = String(index + 1).padStart(2, "0");
      }

      steps.forEach(step => {
        const edge = Number(step.dataset.cvStep) < 0 ? 0 : last;
        step.setAttribute("aria-disabled", String(index === edge));
      });
    };

    const indexAtScroll = () => {
      const middle = track.scrollTop + track.clientHeight / 2;
      return experiences.reduce((found, experience, index) => (experience.offsetTop <= middle ? index : found), 0);
    };

    const goTo = (index: number) => {
      const target = experiences[index];

      if (!target) {
        return;
      }

      pending = index;
      window.clearTimeout(pendingTimer);
      pendingTimer = window.setTimeout(() => (pending = null), 1000);
      track.scrollTo({ top: target.offsetTop, behavior: behavior() });

      if (status) {
        status.textContent = `${index + 1} of ${experiences.length}: ${target.dataset.cvExperience}`;
      }
    };

    const step = (direction: number) => {
      const from = pending ?? active;
      const to = Math.min(Math.max(from + direction, 0), last);

      if (to !== from) {
        goTo(to);
      }
    };

    track.addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const index = indexAtScroll();
          const experience = experiences[index];

          if (index !== active) {
            render(index);
          }

          if (pending === index && experience && Math.abs(track.scrollTop - experience.offsetTop) < 2) {
            pending = null;
          }
        });
      },
      { passive: true }
    );

    steps.forEach(button => {
      button.addEventListener("click", () => {
        if (button.getAttribute("aria-disabled") !== "true") {
          step(Number(button.dataset.cvStep));
        }
      });
    });

    document.addEventListener("keydown", event => {
      const direction = keys[event.key];

      if (!direction || event.altKey || event.ctrlKey || event.metaKey || event.defaultPrevented) {
        return;
      }

      event.preventDefault();

      const current = experiences[active];

      // An entry taller than the paper scrolls through itself before moving on.
      if (pending === null && current) {
        const view = track.getBoundingClientRect();
        const rect = current.getBoundingClientRect();
        const hidden = direction > 0 ? rect.bottom - view.bottom : view.top - rect.top;

        if (hidden > 1) {
          track.scrollBy({ top: direction * Math.min(hidden, view.height * 0.8), behavior: behavior() });
          return;
        }
      }

      step(direction);
    });

    render(indexAtScroll());
  }
</script>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.75em;
    position: relative;
    color: inherit;
    text-decoration: none;
  }

  /* Extends the tap target past the thin frame bar without changing its height. */
  .back::before {
    content: "";
    position: absolute;
    top: 50%;
    right: -0.75rem;
    left: -0.75rem;
    height: max(100%, 2.75rem);
    transform: translateY(-50%);
  }

  .back svg {
    width: 1.6em;
    height: auto;
    flex: none;
  }

  @media (hover: hover) {
    .back:hover > span {
      text-decoration: underline;
      text-underline-offset: 0.3em;
    }
  }

  .back:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 0.35rem;
    border-radius: 3px;
  }

  .progress {
    position: absolute;
    top: calc(var(--frame-top) / -2);
    right: 0.75em;
    z-index: 1;
    margin: 0;
    color: theme("colors.paper");
    font-family: theme("fontFamily.mono");
    font-size: clamp(0.8125rem, 1.45vw, 1.25rem);
    line-height: 1.2;
    letter-spacing: 0.04em;
    transform: translateY(-50%);
  }

  .track {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-snap-type: y mandatory;
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track:focus-visible {
    outline: 3px solid theme("colors.cobalt");
    outline-offset: -6px;
  }

  .steps {
    position: absolute;
    top: 100%;
    right: 0;
    display: flex;
    align-items: center;
    height: max(var(--frame-bottom), 2.75rem);
    color: theme("colors.paper");
  }

  .step {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: none;
    color: inherit;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .step svg {
    width: 1.125rem;
    height: auto;
  }

  .step[aria-disabled="true"] {
    opacity: 0.25;
    cursor: default;
  }

  @media (hover: hover) {
    .step:not([aria-disabled="true"]):hover {
      color: theme("colors.riso.yellow");
    }
  }

  .step:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -2px;
  }

  @media (min-width: 1024px) {
    .progress {
      top: clamp(0.875rem, 2.4vw, 2rem);
      right: clamp(1rem, 2.8vw, 2.5rem);
      padding-bottom: 0.3em;
      border-bottom: 2px solid theme("colors.ink");
      color: inherit;
      transform: none;
    }

    .steps {
      top: 50%;
      right: clamp(0.75rem, 2.2vw, 2.25rem);
      flex-direction: column;
      gap: clamp(3rem, 22vh, 12rem);
      height: auto;
      color: theme("colors.ink");
      transform: translateY(-50%);
    }

    .step {
      width: 3rem;
      height: 3rem;
    }

    .step svg {
      width: clamp(1.25rem, 1.75vw, 1.75rem);
    }

    @media (hover: hover) {
      .step:not([aria-disabled="true"]):hover {
        color: theme("colors.riso.red");
      }
    }
  }
</style>
