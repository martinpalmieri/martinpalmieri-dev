---
import contact from "../data/contact.json";
import { features } from "../data/features";
import { t, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<footer class="footer">
  <nav aria-label={copy.footer.navLabel}>
    <ul class="links">
      {features.linkedin && (
        <li>
          <a href={contact.linkedin} target="_blank" rel="noopener noreferrer">
            LinkedIn<span class="sr-only"> ({copy.opensInNewTab})</span>
          </a>
        </li>
      )}
      <li>
        <a href={contact.github} target="_blank" rel="noopener noreferrer">
          GitHub<span class="sr-only"> ({copy.opensInNewTab})</span>
        </a>
      </li>
      <li><a href={`mailto:${contact.email}`}>{copy.footer.email}</a></li>
    </ul>
  </nav>
</footer>

<style>
  .links {
    display: flex;
    gap: 0.25em;
  }

  a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.5em;
    color: inherit;
    text-decoration: none;
  }

  li:first-child a {
    margin-left: -0.5em;
  }

  @media (hover: hover) {
    a:hover {
      text-decoration: underline;
      text-underline-offset: 0.3em;
    }
  }

  a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -0.35rem;
    border-radius: 3px;
  }
</style>
