---
import Link from "./Link.astro";
import contact from "../data/contact.json";
---

<footer class="fixed bottom-0 right-0 z-10 bg-white bg-opacity-80 p-4">
  <nav aria-label="Social media and contact links">
    <ul class="flex space-x-2">
      <li>
        <Link href={contact.linkedin} label="LinkedIn" />
      </li>
      <li>
        <Link href={contact.github} label="GitHub" />
      </li>
      <li>
        <Link href={`mailto:${contact.email}`} label="Email" />
      </li>
    </ul>
  </nav>
</footer>
