---
interface Props {
  id: string;
  title: string;
  closeLabel: string;
  describedby?: string;
}

const { id, title, closeLabel, describedby } = Astro.props;
const titleId = `${id}-title`;
---

<dialog id={id} class="dialog" aria-labelledby={titleId} aria-describedby={describedby}>
  <div class="card">
    <form method="dialog">
      <button type="submit" class="close">{closeLabel}</button>
    </form>
    <h2 id={titleId} class="title">{title}</h2>
    <slot />
  </div>
</dialog>

<style>
  .dialog {
    width: min(100% - 2.5rem, 26rem);
    max-width: none;
    padding: 0;
    overflow: visible;
    border: 0;
    background: transparent;
    color: theme("colors.ink");
  }

  .dialog::backdrop {
    background: rgb(10 45 145 / 0.8);
  }

  .card {
    position: relative;
    padding: 1.5rem 1.5rem 1.75rem;
    border: 3px solid theme("colors.ink");
    background-color: theme("colors.paper");
    background-image: var(--grain-paper);
    box-shadow: 10px 10px 0 theme("colors.ink");
    transform: rotate(-1deg);
  }

  .card::before {
    content: "";
    position: absolute;
    top: -0.9rem;
    left: 50%;
    width: 6.5rem;
    height: 1.6rem;
    background: rgb(249 203 20 / 0.88);
    transform: translateX(-50%) rotate(-4deg);
  }

  .close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    min-width: 44px;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border: 2px solid theme("colors.ink");
    background: theme("colors.paper");
    color: inherit;
    font: 700 0.8125rem/1 theme("fontFamily.sans");
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .close:hover {
    background: theme("colors.riso.yellow");
  }

  .close:focus-visible {
    outline: 3px solid theme("colors.cobalt");
    outline-offset: 3px;
  }

  .title {
    margin: 0.5rem 5.5rem 1.25rem 0;
    font-family: theme("fontFamily.display");
    font-size: clamp(2.75rem, 13vw, 4rem);
    font-weight: 400;
    line-height: 0.95;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: no-preference) {
    .dialog[open] .card {
      animation: home-dialog-in 180ms cubic-bezier(0.2, 0.8, 0.3, 1);
    }

    .dialog[open]::backdrop {
      animation: home-backdrop-in 180ms ease-out;
    }
  }

  @keyframes home-dialog-in {
    from {
      opacity: 0;
      transform: translateY(12px) rotate(-3deg) scale(0.96);
    }
  }

  @keyframes home-backdrop-in {
    from {
      opacity: 0;
    }
  }
</style>
