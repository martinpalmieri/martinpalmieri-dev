---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  label: string;
  image: ImageMetadata;
  href?: string;
  dialog?: string;
}

const { label, image, href, dialog } = Astro.props;

const Tag = href ? "a" : "button";
const attributes = href
  ? { href }
  : ({
      type: "button",
      "aria-haspopup": "dialog",
      "aria-controls": dialog,
      "data-dialog-target": dialog,
    } as const);
---

<Tag class="tile" {...attributes}>
  <span class="body">
    <span class="art">
      <Picture
        src={image}
        alt=""
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        width={480}
        widths={[240, 360, 480, 640, 800]}
        sizes="(min-width: 1024px) min(20vw, 380px), (min-width: 600px) and (min-aspect-ratio: 3/2) min(20vw, 380px), (min-width: 600px) min(34vw, 320px), 40vw"
        loading="eager"
      />
    </span>
    <span class="label">{label}</span>
  </span>
</Tag>

<style>
  .tile {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* Form controls use engine-specific internal boxes, so the size container is a plain wrapper. */
  .body {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  /* Sized to the tallest illustration so every label sits on the same line. */
  .art {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1222 / 1151;
  }

  .art :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
  }

  .label {
    position: relative;
    margin-top: 0.3em;
    padding-bottom: 0.4em;
    font-family: theme("fontFamily.display");
    font-size: clamp(1.125rem, 19cqi, 3.5rem);
    line-height: 1.1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .label::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 50cqi;
    height: 2px;
    background: currentColor;
    opacity: 0.6;
    transform: translateX(-50%);
  }

  .tile:focus-visible {
    outline: 3px solid theme("colors.ink");
    outline-offset: 8px;
    border-radius: 4px;
  }

  .tile:focus-visible .label::after {
    height: 4px;
    background: theme("colors.riso.red");
    opacity: 1;
  }

  .tile:active .label {
    color: theme("colors.riso.red");
  }

  @media (hover: hover) {
    .tile:hover .label::after {
      height: 4px;
      background: theme("colors.riso.red");
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .art {
      transition: transform 180ms cubic-bezier(0.2, 0.8, 0.3, 1);
    }

    .tile:focus-visible .art {
      transform: translateY(-6px) rotate(var(--tilt, -2deg));
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .tile:hover .art {
      transform: translateY(-6px) rotate(var(--tilt, -2deg));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .tile:active .art {
      transform: translateY(-1px) rotate(var(--tilt, -2deg)) scale(0.97);
      transition-duration: 80ms;
    }
  }
</style>
